default_platform(:ios)

SCHEME       = "RepoMind"
BUNDLE_ID    = "idanidev.RepoMind"
PROJECT      = "RepoMind.xcodeproj"

platform :ios do

  # ── API KEY ─────────────────────────────────────────────────────────────────
  def api_key
    app_store_connect_api_key(
      key_id:        ENV["ASC_KEY_ID"],
      issuer_id:     ENV["ASC_ISSUER_ID"],
      key_filepath:  ENV["ASC_KEY_FILEPATH"],
      duration:      1200,
      in_house:      false
    )
  end


  # ── LANE: certificates ──────────────────────────────────────────────────────
  desc "Sincroniza certificados de distribución con match"
  lane :certificates do
    match(
      type:     "appstore",
      api_key:  api_key,
      readonly: false
    )
  end


  # ── LANE: build ─────────────────────────────────────────────────────────────
  desc "Compila la app en modo Release"
  lane :build do
    build_number = Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_number,
      xcodeproj:    PROJECT
    )

    match(
      type:     "appstore",
      api_key:  api_key,
      readonly: true
    )

    gym(
      scheme:           SCHEME,
      project:          PROJECT,
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "./build",
      output_name:      "RepoMind.ipa",
      clean:            true,
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => ENV["sigh_#{BUNDLE_ID.gsub('.','_')}_appstore_profile-name"]
        }
      }
    )
  end


  # ── LANE: beta ──────────────────────────────────────────────────────────────
  desc "Sube una build a TestFlight"
  lane :beta do
    build

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "./build/RepoMind.ipa",
      skip_waiting_for_build_processing: true
    )

    UI.success "✅ Build subida a TestFlight correctamente"
  end


  # ── LANE: release ───────────────────────────────────────────────────────────
  # Solo compila y sube el binario. NO envía a revisión (usa `submit` después).
  desc "Compila y sube el IPA a App Store Connect (sin enviar a revisión)"
  lane :release do
    build

    deliver(
      api_key:                      api_key,
      ipa:                          "./build/RepoMind.ipa",
      submit_for_review:            false,
      automatic_release:            false,
      force:                        true,
      skip_screenshots:             true,
      skip_metadata:                true,
      run_precheck_before_submit:   false,
      submission_information: {
        export_compliance_uses_encryption: false
      }
    )

    UI.success "✅ IPA subido a App Store Connect. Ejecuta `fastlane submit` cuando el build esté procesado."
  end


  # ── LANE: submit ────────────────────────────────────────────────────────────
  # Envía a revisión el build ya procesado por Apple (~15 min después de release).
  desc "Envía a revisión el build ya subido (sin recompilar)"
  lane :submit do |options|
    app_ver = options[:version] || get_version_number(xcodeproj: PROJECT, target: SCHEME)

    deliver(
      api_key:                      api_key,
      app_version:                  app_ver,
      skip_binary_upload:           true,
      submit_for_review:            true,
      reject_if_possible:           true,
      automatic_release:            false,
      force:                        true,
      skip_screenshots:             true,
      skip_metadata:                true,
      run_precheck_before_submit:   false,
      submission_information: {
        export_compliance_uses_encryption: false
      }
    )

    UI.success "🚀 iOS v#{app_ver} enviada a revisión en App Store"
  end


  # ── LANE: bump_version ──────────────────────────────────────────────────────
  desc "Sube la versión de marketing (ej: fastlane bump_version version:1.1)"
  lane :bump_version do |options|
    version = options[:version] || UI.input("Nueva versión (ej: 1.1.0):")
    increment_version_number(
      version_number: version,
      xcodeproj:      PROJECT
    )
    UI.success "✅ Versión actualizada a #{version}"
  end


  error do |lane, exception|
    UI.error "❌ Error en lane '#{lane}': #{exception.message}"
  end

end


# ── PLATAFORMA macOS (Mac Catalyst) ──────────────────────────────────────────
platform :mac do

  def api_key
    app_store_connect_api_key(
      key_id:        ENV["ASC_KEY_ID"],
      issuer_id:     ENV["ASC_ISSUER_ID"],
      key_filepath:  ENV["ASC_KEY_FILEPATH"],
      duration:      1200,
      in_house:      false
    )
  end

  MAC_BUNDLE_ID = "maccatalyst.#{BUNDLE_ID}"

  # ── LANE: certificates ──────────────────────────────────────────────────────
  desc "Genera el perfil Mac Catalyst"
  lane :certificates do
    match(
      type:           "appstore",
      platform:       "ios",
      app_identifier: [MAC_BUNDLE_ID],
      api_key:        api_key,
      readonly:       false
    )
  end


  # ── LANE: build ─────────────────────────────────────────────────────────────
  desc "Compila la app macOS (Mac Catalyst) en modo Release"
  lane :build do
    build_number = Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_number,
      xcodeproj:    PROJECT
    )

    root_dir      = File.expand_path("..")
    archive_path  = "#{root_dir}/build/RepoMind-mac.xcarchive"
    export_dir    = "#{root_dir}/build"
    export_plist  = "/tmp/repomind_mac_export_options.plist"
    key_path      = ENV["ASC_KEY_FILEPATH"]
    key_id        = ENV["ASC_KEY_ID"]
    issuer_id     = ENV["ASC_ISSUER_ID"]

    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store-connect</string>
        <key>teamID</key><string>AXK73U74AC</string>
        <key>destination</key><string>export</string>
        <key>signingStyle</key><string>automatic</string>
      </dict>
      </plist>
    PLIST

    Dir.chdir(root_dir) do
      sh "xcodebuild " \
         "-scheme #{SCHEME} " \
         "-project #{PROJECT} " \
         "-configuration Release " \
         "-destination 'generic/platform=macOS,variant=Mac Catalyst' " \
         "-archivePath '#{archive_path}' " \
         "archive " \
         "DEVELOPMENT_TEAM=AXK73U74AC " \
         "-allowProvisioningUpdates " \
         "-authenticationKeyPath '#{key_path}' " \
         "-authenticationKeyID #{key_id} " \
         "-authenticationKeyIssuerID #{issuer_id} " \
         "| xcpretty || true"

      sh "xcodebuild " \
         "-exportArchive " \
         "-archivePath '#{archive_path}' " \
         "-exportPath '#{export_dir}' " \
         "-exportOptionsPlist '#{export_plist}' " \
         "-allowProvisioningUpdates " \
         "-authenticationKeyPath '#{key_path}' " \
         "-authenticationKeyID #{key_id} " \
         "-authenticationKeyIssuerID #{issuer_id}"
    end
  end


  # ── LANE: release ───────────────────────────────────────────────────────────
  # Solo compila y sube el PKG. NO envía a revisión (usa `mac submit` después).
  desc "Compila y sube el PKG a App Store Connect (sin enviar a revisión)"
  lane :release do
    build

    deliver(
      api_key:                    api_key,
      pkg:                        "./build/RepoMind.pkg",
      platform:                   "osx",
      submit_for_review:          false,
      automatic_release:          false,
      force:                      true,
      skip_screenshots:           true,
      skip_metadata:              true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false
      }
    )

    UI.success "✅ PKG subido a App Store Connect. Ejecuta `fastlane mac submit` cuando el build esté procesado."
  end


  # ── LANE: submit ────────────────────────────────────────────────────────────
  desc "Envía a revisión el build macOS ya subido (sin recompilar)"
  lane :submit do |options|
    app_ver = options[:version] || get_version_number(xcodeproj: "../#{SCHEME}.xcodeproj", target: SCHEME)

    deliver(
      api_key:                      api_key,
      platform:                     "osx",
      app_version:                  app_ver,
      skip_binary_upload:           true,
      submit_for_review:            true,
      reject_if_possible:           true,
      automatic_release:            false,
      force:                        true,
      skip_screenshots:             true,
      skip_metadata:                true,
      run_precheck_before_submit:   false,
      submission_information: {
        export_compliance_uses_encryption: false
      }
    )

    UI.success "🚀 macOS v#{app_ver} enviada a revisión en App Store"
  end


  error do |lane, exception|
    UI.error "❌ Error en lane mac '#{lane}': #{exception.message}"
  end

end
