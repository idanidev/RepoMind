<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Exportación del workflow de GitHub Actions: sube el archive a App Store Connect
	     con firma automática en la nube y el número de build que toque. Hasta el 27-oct
	     llevaba `testFlightInternalTestingOnly`, que marca la build como válida solo para
	     TestFlight interno y la deja fuera de la revisión de la tienda; sin esa clave la
	     build se puede enviar a revisión (no probado: si App Store Connect la sigue
	     rechazando, hay que firmar con match). -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>AXK73U74AC</string>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
